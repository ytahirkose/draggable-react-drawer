{
  "name": "draggable-react-drawer",
  "version": "1.3.0",
  "type": "module",
  "description": "A modern, accessible, and highly customizable draggable drawer component for React 18+ and React 19",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.esm.js",
  "scripts": {
    "build:dev": "rollup -c --environment NODE_ENV:development",
    "build": "rollup -c --environment NODE_ENV:production",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "clean": "rm -rf dist",
    "demo": "cd demo && npm install --legacy-peer-deps && npm run dev",
    "demo:build": "cd demo && npm install --legacy-peer-deps && npm run build"
  },
  "keywords": [
    "react",
    "typescript",
    "draggable",
    "drawer",
    "bottom-sheet",
    "modal",
    "mobile-ui",
    "react-ui",
    "antd-mobile",
    "ant design mobile",
    "accessibility",
    "a11y"
  ],
  "author": "Yaşar Tahir Köse",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ytahirkose/draggable-react-drawer.git"
  },
  "homepage": "https://github.com/ytahirkose/draggable-react-drawer#readme",
  "bugs": {
    "url": "https://github.com/ytahirkose/draggable-react-drawer/issues"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-react": "^7.24.7",
    "@babel/preset-typescript": "^7.27.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^26.0.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.3",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^9.35.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "postcss": "^8.4.45",
    "rollup": "^4.21.2",
    "rollup-plugin-babel": "^4.4.0",
    "rollup-plugin-dts": "^6.2.3",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-terser": "7.0.2",
    "ts-jest": "^29.4.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0 || ^19.0.0",
    "react-dom": ">=18.0.0 || ^19.0.0",
    "antd-mobile": ">=5.1.1",
    "antd": ">=5.1.1"
  },
  "peerDependenciesMeta": {
    "antd-mobile": {
      "optional": true
    },
    "antd": {
      "optional": true
    }
  }
}
